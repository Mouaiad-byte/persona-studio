# Google OAuth client for the YouTube collector.
# Create one at https://console.cloud.google.com/apis/credentials
#   - application type: Web application
#   - authorised redirect URI: http://localhost:8787/auth/google/callback
# Enable both "YouTube Data API v3" and "YouTube Analytics API" on the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the redirect URI registered above.
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback

# Ask for the monetary analytics scope as well. Only useful on a monetised
# channel; leave false unless you need collected payout figures.
GOOGLE_INCLUDE_REVENUE_SCOPE=false

# Collector port. The Vite dev proxy expects 8787.
PORT=8787

# Collect automatically every N minutes while `npm run server` is running.
# 0 (the default) means manual only — run `npm run collect` yourself.
# 360 (six hours) is plenty: these APIs revise recent days anyway, and each run
# spends quota.
COLLECT_INTERVAL_MINUTES=0
